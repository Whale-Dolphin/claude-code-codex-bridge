#!/usr/bin/env bash
set -euo pipefail

die() {
  printf 'claudex-remote-control: %s\n' "$*" >&2
  exit 1
}

routectl_bin=${ROUTECTL_BIN:-}
if [[ -z "$routectl_bin" ]]; then
  routectl_bin=$(command -v routectl) || die 'routectl is not installed or not on PATH'
fi

claude_bin=${CLAUDE_BIN:-}
if [[ -z "$claude_bin" ]]; then
  claude_bin=$(command -v claude) || die 'claude is not installed or not on PATH'
fi

config_root=${XDG_CONFIG_HOME:-"$HOME/.config"}
routectl_config=${ROUTECTL_CONFIG:-"$config_root/routectl/config.toml"}
[[ -r "$routectl_config" ]] || die "cannot read routectl config: $routectl_config"

https_proxy=''
node_extra_ca_certs=''
while IFS='=' read -r name value; do
  case "$name" in
    HTTPS_PROXY) https_proxy=$value ;;
    NODE_EXTRA_CA_CERTS) node_extra_ca_certs=$value ;;
  esac
done < <("$routectl_bin" --config "$routectl_config" rc env)

[[ "$https_proxy" =~ ^http://(127\.0\.0\.1|localhost|\[::1\]):[0-9]+$ ]] ||
  die 'routectl MITM proxy is missing or is not loopback-only'
[[ -r "$node_extra_ca_certs" ]] ||
  die "cannot read routectl MITM CA: $node_extra_ca_certs"

session_name='Claudex Remote Control'
if [[ $# -gt 0 && "$1" != -* ]]; then
  session_name=$1
  shift
fi

exec env \
  -u ANTHROPIC_BASE_URL \
  -u ANTHROPIC_AUTH_TOKEN \
  -u ANTHROPIC_API_KEY \
  -u CLAUDE_CODE_DISABLE_NONESSENTIAL_TRAFFIC \
  -u CLAUDE_CODE_EFFORT_LEVEL \
  -u CLAUDE_CODE_USE_BEDROCK \
  -u CLAUDE_CODE_SKIP_BEDROCK_AUTH \
  -u CLAUDE_CODE_USE_VERTEX \
  -u CLAUDE_CODE_USE_FOUNDRY \
  -u HTTPS_PROXY \
  -u https_proxy \
  -u HTTP_PROXY \
  -u http_proxy \
  -u ALL_PROXY \
  -u all_proxy \
  -u NO_PROXY \
  -u no_proxy \
  HTTPS_PROXY="$https_proxy" \
  NODE_EXTRA_CA_CERTS="$node_extra_ca_certs" \
  ANTHROPIC_DEFAULT_FABLE_MODEL='gpt-6-astra-fast[1m]' \
  ANTHROPIC_DEFAULT_OPUS_MODEL='gpt-5.6-sol-fast[1m]' \
  ANTHROPIC_DEFAULT_SONNET_MODEL='gpt-5.6-terra' \
  ANTHROPIC_DEFAULT_HAIKU_MODEL='gpt-5.6-luna' \
  CLAUDE_CODE_SUBAGENT_MODEL='gpt-6-astra-fast[1m]' \
  CLAUDE_CODE_MAX_CONTEXT_TOKENS='1000000' \
  CLAUDE_CODE_ALWAYS_ENABLE_EFFORT='1' \
  CLAUDE_CODE_MAX_TOOL_USE_CONCURRENCY='3' \
  ENABLE_TOOL_SEARCH='false' \
  "$claude_bin" \
    --remote-control "$session_name" \
    --model fable \
    --effort xhigh \
    --autocompact 600k \
    "$@"
